{
  "name": "subscription-proxy-inator",
  "version": "2.0.0",
  "description": "A cross-platform desktop gateway for routing OpenAI, Anthropic, Gemini, Grok, and compatible AI providers through one local API.",
  "author": "Suraj Mandal <surajmandalcell@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "build": "vite build && node scripts/verify.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/verify.mjs && node --test tests/*.test.js",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@pikoloo/darwin-ui": "2.1.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.0.6",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.mandalsuraj.subscriptionproxyinator",
    "productName": "Subscription Proxy Inator",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "desktop/main/**/*",
      "desktop/shared/**/*",
      "docs/**/*",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "linux": {
      "category": "Development",
      "target": ["AppImage", "deb"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "surajmandalcell",
      "repo": "subscription-proxy-inator"
    }
  }
}
