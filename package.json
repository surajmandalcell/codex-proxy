{
  "name": "subscription-proxy-inator",
  "version": "2.1.0",
  "private": true,
  "description": "Cross-platform desktop AI gateway for multi-provider routing, failover, compatibility translation, and local usage accounting.",
  "author": "Suraj Mandal <surajmandalcell@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main/index.js",
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surajmandalcell/subscription-proxy-inator.git"
  },
  "bugs": {
    "url": "https://github.com/surajmandalcell/subscription-proxy-inator/issues"
  },
  "homepage": "https://surajmandalcell.github.io/subscription-proxy-inator/",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "verify": "node scripts/verify.mjs",
    "check:links": "node scripts/check-links.mjs",
    "build:site": "node scripts/build-site.mjs && node scripts/check-links.mjs --site",
    "build:renderer": "vite build",
    "check": "npm run verify && npm run test:coverage && npm run check:links",
    "build": "npm run check && npm run build:renderer && npm run build:site",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "better-sqlite3": "12.2.0",
    "fastify": "5.10.0",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.6.0",
    "concurrently": "9.2.0",
    "cross-env": "7.0.3",
    "electron": "37.2.0",
    "electron-builder": "26.0.12",
    "typescript": "5.8.3",
    "vite": "7.0.6",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "com.mandalsuraj.subscriptionproxyinator",
    "productName": "Subscription Proxy Inator",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/renderer/**/*",
      "desktop/main/**/*",
      "desktop/preload/**/*",
      "src/**/*",
      "docs/**/*",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.svg",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "surajmandalcell",
      "repo": "subscription-proxy-inator"
    }
  },
  "packageManager": "npm@10.9.2"
}
