{
  "name": "@pikoloo/codex-proxy",
  "version": "1.2.0",
  "description": "Local personal proxy for OpenAI Codex models with Claude API compatibility",
  "author": "Suraj Mandal <surajmandalcell@gmail.com>",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "codex-proxy": "bin/cli.js",
    "codex-claude-proxy": "bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "public",
    "docs",
    "images",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surajmandalcell/codex-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/surajmandalcell/codex-proxy/issues"
  },
  "homepage": "https://github.com/surajmandalcell/codex-proxy#readme",
  "scripts": {
    "start": "node src/index.js",
    "accounts": "node src/cli/accounts.js",
    "accounts:add": "node src/cli/accounts.js add",
    "accounts:add:headless": "node src/cli/accounts.js add --no-browser",
    "accounts:list": "node src/cli/accounts.js list",
    "accounts:remove": "node src/cli/accounts.js remove",
    "accounts:verify": "node src/cli/accounts.js verify",
    "build": "find src bin scripts \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -n1 node --check",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:all": "node --test tests/unit/*.test.js tests/*.test.js",
    "test:api": "node --test tests/api.test.js",
    "test:routing": "node --test tests/routing.test.js",
    "test:cors": "node --test tests/cors_security.test.js",
    "test:ui": "node --test tests/ui.test.js"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.3-r.1",
    "alpinejs": "3.15.12",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "qs": "6.15.2"
  },
  "keywords": [
    "codex",
    "openai",
    "proxy",
    "claude",
    "chatgpt",
    "oauth"
  ],
  "license": "MIT"
}
